<section id="cover">
  <h1>{{ t('report.title') }}</h1>
  <p class="disclaimer">{{ t('disclaimer') }}</p>
  {% if placeholder %}<p class="banner">{{ t('report.placeholder_banner') }}</p>{% endif %}
  <h2>{{ t('report.section.cover') }}</h2>
  <table class="cover">
    <tbody>
    {% for label, value, mono in cover_rows %}
    <tr><th>{{ label }}</th><td{% if mono %} class="mono"{% endif %}>{{ value }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  <table class="rulepacks">
    <thead><tr><th>{{ t('report.label.rulepacks') }}</th><th>{{ t('report.label.version') }}</th><th>{{ t('report.label.source_status') }}</th><th>SHA-256</th></tr></thead>
    <tbody>
    {% for pack in results.rulepacks %}
    <tr><td>{{ pack.name }} ({{ pack.source }})</td><td>{{ pack.version }}</td><td>{{ fmt.label('source_status', pack.source_status.value) }}</td><td class="mono">{{ pack.sha256 }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% for pack in secondary_packs %}<p class="secondary-note">{{ t('report.text.secondary_note', pack=pack.name) }}</p>{% endfor %}
  {% if core_loaded %}<p class="core-clause-note">{{ t('report.text.core_clause_note') }}</p>{% endif %}
  <p class="scope-note">{{ t('report.text.scope_note') }}</p>
</section>
