{% macro finding_table(group) %}
  <table class="findings">
    <colgroup><col class="w-rule"><col class="w-clause"><col class="w-title"><col class="w-status"><col class="w-file"><col class="w-channel"><col class="w-measured"><col class="w-threshold"><col class="w-time"><col class="w-reason"></colgroup>
    <thead><tr><th>{{ t('report.label.rule') }}</th><th>{{ t('report.label.clause') }}</th><th>{{ t('report.label.title') }}</th><th>{{ t('report.label.status') }}</th><th>{{ t('report.label.file') }}</th><th>{{ t('report.label.channel') }}</th><th>{{ t('report.label.measured') }}</th><th>{{ t('report.label.threshold') }}</th><th>{{ t('report.label.time_range') }}</th><th>{{ t('report.label.reason') }}</th></tr></thead>
    <tbody>
    {% for row in group.rows %}
    <tr data-key="{{ row.key }}">{% for cell in finding_cells %}<td class="c-{{ cell }}{% if cell in ('rule', 'file') %} mono{% endif %}">{{ row[cell] }}</td>{% endfor %}</tr>
    {% endfor %}
    </tbody>
  </table>
{% endmacro %}
{% macro consent_table(consent) %}
  <table class="consent">
    <thead><tr><th>{{ t('report.consent.use') }}</th><th>{{ t('report.label.status') }}</th><th>{{ t('report.label.reason') }}</th><th>{{ t('report.consent.count') }}</th></tr></thead>
    <tbody>
    {% for row in consent.rows %}
    {% if row.withheld %}<tr><td>{{ row.use }}</td><td colspan="2">{{ row.withheld }}</td><td>{{ row.count }}</td></tr>
    {% else %}<tr><td>{{ row.use }}</td><td>{{ row.status }}</td><td>{{ row.reason }}</td><td>{{ row.count }}</td></tr>
    {% endif %}
    {% endfor %}
    </tbody>
  </table>
  <p class="consent-note">{{ consent.note }}</p>
{% endmacro %}
{% macro group_body(group) %}
{% if group.consent %}{{ consent_table(group.consent) }}{% elif not group.reconsent %}{{ finding_table(group) }}{% endif %}
{% endmacro %}
<section id="findings">
  <h2>{{ t('report.section.findings') }}</h2>
  {% for section in severity_sections %}
  <h3 class="sev-{{ section.severity }}">{{ section.heading }}</h3>
  {% if section.note %}<p class="consent-severity-note">{{ section.note }}</p>{% endif %}
  {% if section.groups %}
  {% for group in section.groups %}
  <div class="rule-group" data-rule="{{ group.rule }}">
    <h4><span class="nowrap">{{ group.rule }}</span>{% if group.title %} – {{ group.title }}{% endif %}</h4>
    <p class="aggregate">{{ group.aggregate }}</p>
    {{ group_body(group) }}
    {% if group.more %}<p class="more">{{ group.more }}</p>{% endif %}
  </div>
  {% endfor %}
  {% else %}
  <p>{{ t('report.text.no_findings') }}</p>
  {% endif %}
  {% endfor %}
  {% if placeholder_groups %}
  <div class="placeholder-group">
    <h3>{{ t('report.label.placeholder_findings') }} ({{ placeholder_count }})</h3>
    {% for group in placeholder_groups %}
    <div class="rule-group" data-rule="{{ group.rule }}">
      <h4><span class="nowrap">{{ group.rule }}</span>{% if group.title %} – {{ group.title }}{% endif %}</h4>
      <p class="aggregate">{{ group.aggregate }}</p>
      {{ group_body(group) }}
      {% if group.more %}<p class="more">{{ group.more }}</p>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% if reconsent %}
  <div class="reconsent" id="reconsent">
    <h3>{{ reconsent.heading }}</h3>
    {% if reconsent.text %}<p class="reconsent-text">{{ reconsent.text }}</p>
    <p class="reconsent-legend">{{ reconsent.legend }}</p>{% endif %}
    {% for rule in reconsent.rules %}
    <div class="reconsent-rule" data-rule="{{ rule.rule }}">
      <h4><span class="nowrap">{{ rule.rule }}</span>{% if rule.title %} – {{ rule.title }}{% endif %}</h4>
      {% if rule.state %}<p class="reconsent-state">{{ rule.state }}</p>
      {% else %}
      <table class="reconsent">
        <thead><tr><th>{{ t('report.reconsent.risk') }}</th><th>{{ t('report.reconsent.date') }}</th><th>{{ t('report.reconsent.uses') }}</th><th>{{ t('report.reconsent.subjects') }}</th><th>{{ t('report.reconsent.results') }}</th></tr></thead>
        <tbody>
        {% for row in rule.rows %}
        <tr><td class="mono nowrap">{{ row.risk }}</td><td class="nowrap">{{ row.date }}</td><td>{{ row.uses }}</td><td>{{ row.subjects }}</td><td>{% for cell in row.cells %}{{ cell }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% if rule.more %}<p class="more">{{ rule.more }}</p>{% endif %}
      {% endif %}
    </div>
    {% endfor %}
    <p class="reconsent-note">{{ reconsent.note }}</p>
  </div>
  {% endif %}
</section>
