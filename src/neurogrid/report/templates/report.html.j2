<!DOCTYPE html>
<html lang="{{ 'zh-CN' if lang == 'zh' else lang }}">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:">
<meta name="generator" content="NeuroGrid {{ results.tool.version }}">
<title>{{ t('report.title') }}</title>
<style>
  body { font-family: "Noto Sans SC", "Microsoft YaHei", "PingFang SC", Arial, sans-serif; font-size: 10.5pt; color: #1b1b1b; margin: 24px; line-height: 1.45; }
  h1 { font-size: 18pt; margin: 0 0 6px 0; }
  h2 { font-size: 13pt; border-bottom: 1px solid #999; padding-bottom: 3px; margin-top: 28px; }
  h3 { font-size: 11pt; margin-top: 18px; }
  table { border-collapse: collapse; width: 100%; margin: 8px 0 12px 0; }
  th, td { border: 1px solid #c8c8c8; padding: 4px 6px; text-align: left; vertical-align: top; }
  th { background: #f0f0f0; }
  .disclaimer { border: 1px solid #555; padding: 8px 10px; background: #fafafa; font-weight: 600; }
  .banner { border: 2px solid #b00020; padding: 8px 10px; color: #b00020; margin: 10px 0; }
  .light { display: inline-block; padding: 1px 8px; border-radius: 8px; font-weight: 600; }
  .light-red { background: #f6c7c7; } .light-yellow { background: #f7e7a6; }
  .light-green { background: #c9ebc9; } .light-grey { background: #e3e3e3; }
  .mono { font-family: Consolas, "Courier New", monospace; font-size: 9pt; word-break: break-all; }
  pre { white-space: pre-wrap; font-size: 8.5pt; background: #f7f7f7; padding: 6px; }
  footer { margin-top: 32px; font-size: 9pt; color: #444; }
</style>
</head>
<body>

<section id="cover">
  <h1>{{ t('report.title') }}</h1>
  <p class="disclaimer">{{ t('disclaimer') }}</p>
  {% if placeholder %}<p class="banner">{{ t('report.placeholder_banner') }}</p>{% endif %}
  <h2>{{ t('report.section.cover') }}</h2>
  <table>
    <tr><th>{{ t('report.label.dataset') }}</th><td>{{ fmt.value(results.dataset.name) }}</td></tr>
    <tr><th>{{ t('report.label.dataset_id') }}</th><td>{{ results.dataset.id }}</td></tr>
    <tr><th>{{ t('report.label.version') }}</th><td>{{ fmt.value(results.dataset.version) }}</td></tr>
    <tr><th>{{ t('report.label.license') }}</th><td>{{ fmt.value(results.dataset.license) }}</td></tr>
    <tr><th>{{ t('report.label.date') }}</th><td>{{ results.config.as_of.isoformat() }}</td></tr>
    <tr><th>{{ t('report.label.tool_version') }}</th><td>NeuroGrid {{ results.tool.version }}</td></tr>
    <tr><th>{{ t('report.label.manifest_hash') }}</th><td class="mono">{{ fmt.value(results.dataset.manifest_hash) }}</td></tr>
  </table>
  <table>
    <tr><th>{{ t('report.label.rulepacks') }}</th><th>{{ t('report.label.version') }}</th><th>{{ t('report.label.source_status') }}</th><th>SHA-256</th></tr>
    {% for pack in results.rulepacks %}
    <tr><td>{{ pack.name }} ({{ pack.source }})</td><td>{{ pack.version }}</td><td>{{ pack.source_status.value }}</td><td class="mono">{{ pack.sha256 }}</td></tr>
    {% endfor %}
  </table>
</section>

<section id="summary">
  <h2>{{ t('report.section.summary') }}</h2>
  <p><strong>{{ t('report.text.overall_fails') if results.summary.exit_code else t('report.text.overall_passes') }}</strong></p>
  <table>
    <tr><th>{{ t('report.label.phase') }}</th><th>{{ t('report.label.light') }}</th><th>{{ t('report.label.errors') }}</th><th>{{ t('report.label.warnings') }}</th><th>{{ t('report.label.open_evidence') }}</th></tr>
    {% for phase, summary in phases %}
    <tr>
      <td>{{ t('phase.' ~ phase.value) }}</td>
      <td><span class="light light-{{ summary.light.value }}">{{ t('light.' ~ summary.light.value) }}</span></td>
      <td>{{ summary.errors }}</td><td>{{ summary.warnings }}</td><td>{{ summary.open_evidence }}</td>
    </tr>
    {% endfor %}
  </table>
  <p>{{ t('light.legend') }}</p>
  <table>
    <tr><th>{{ t('report.label.rulepacks') }}</th><th>{{ t('report.label.coverage') }}</th></tr>
    {% for name, value in results.summary.coverage.items() %}
    <tr><td>{{ name }}</td><td>{{ t('report.value.na') if value == 'n/a' else ('%.1f %%' % (value * 100)) }}</td></tr>
    {% endfor %}
  </table>
  <p>{{ t('report.label.passed_checks') }}: {{ passed_total }}</p>
</section>

<section id="findings">
  <h2>{{ t('report.section.findings') }}</h2>
  {% for severity, items in by_severity %}
  <h3>{{ t('severity.' ~ severity.value) }} ({{ items | length }})</h3>
  {% if items %}
  <table>
    <tr><th>{{ t('report.label.rule') }}</th><th>{{ t('report.label.clause') }}</th><th>{{ t('report.label.title') }}</th><th>{{ t('report.label.status') }}</th><th>{{ t('report.label.file') }}</th><th>{{ t('report.label.measured') }}</th><th>{{ t('report.label.threshold') }}</th><th>{{ t('report.label.time_range') }}</th><th>{{ t('report.label.reason') }}</th></tr>
    {% for f in items %}
    <tr>
      <td class="mono">{{ f.rule_id }}</td>
      <td>{{ fmt.clause(f) }}</td>
      <td>{{ titles[f.rule_id] }}{% if f.subkey %} – {{ f.subkey }}{% endif %}</td>
      <td>{{ fmt.status(f) }}</td>
      <td class="mono">{{ f.file or t('report.value.dataset_level') }}</td>
      <td>{{ fmt.measured(f) }}</td>
      <td>{{ fmt.value(f.threshold) }}</td>
      <td>{{ fmt.time_range(f) }}</td>
      <td>{{ fmt.details(f) }}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p>{{ t('report.text.no_findings') }}</p>
  {% endif %}
  {% endfor %}
  {% if placeholder_findings %}
  <h3>{{ t('report.label.placeholder_findings') }} ({{ placeholder_findings | length }})</h3>
  <table>
    <tr><th>{{ t('report.label.rule') }}</th><th>{{ t('report.label.clause') }}</th><th>{{ t('report.label.title') }}</th><th>{{ t('report.label.status') }}</th><th>{{ t('report.label.file') }}</th><th>{{ t('report.label.measured') }}</th><th>{{ t('report.label.threshold') }}</th><th>{{ t('report.label.time_range') }}</th><th>{{ t('report.label.reason') }}</th></tr>
    {% for f in placeholder_findings %}
    <tr>
      <td class="mono">{{ f.rule_id }}</td>
      <td>{{ fmt.clause(f) }}</td>
      <td>{{ titles[f.rule_id] }}{% if f.subkey %} – {{ f.subkey }}{% endif %}</td>
      <td>{{ fmt.status(f) }}</td>
      <td class="mono">{{ f.file or t('report.value.dataset_level') }}</td>
      <td>{{ fmt.measured(f) }}</td>
      <td>{{ fmt.value(f.threshold) }}</td>
      <td>{{ fmt.time_range(f) }}</td>
      <td>{{ fmt.details(f) }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}
</section>

<section id="metrics">
  <h2>{{ t('report.section.metrics') }}</h2>
  {% if results.recordings %}
  <table>
    <tr><th>{{ t('report.label.recording') }}</th><th>{{ t('report.label.format') }}</th><th>{{ t('report.label.sampling_rate') }}</th><th>{{ t('report.label.duration') }}</th><th>{{ t('report.label.channels') }}</th></tr>
    {% for rec in results.recordings %}
    <tr><td class="mono">{{ rec.id }}</td><td>{{ rec.format }}</td><td>{{ fmt.value(rec.sampling_rate_hz) }}</td><td>{{ fmt.value(rec.duration_s) }}</td><td>{{ fmt.value(rec.n_channels) }} ({{ fmt.value(rec.n_eeg_channels) }})</td></tr>
    {% endfor %}
  </table>
  {% else %}
  <p>{{ t('report.text.no_recordings') }}</p>
  {% endif %}
</section>

<section id="evidence">
  <h2>{{ t('report.section.evidence') }}</h2>
  {% if manual_rules %}
  <table>
    <tr><th>{{ t('report.label.rule') }}</th><th>{{ t('report.label.title') }}</th><th>{{ t('report.label.status') }}</th><th>{{ t('report.label.reason') }}</th></tr>
    {% for rule in manual_rules %}
    {% set f = manual_findings.get(rule.id) %}
    <tr><td class="mono">{{ rule.id }}</td><td>{{ titles[rule.id] }}</td><td>{{ fmt.status(f) if f else t('report.value.evidence_provided') }}</td><td>{{ fmt.details(f) if f else t('report.value.none') }}</td></tr>
    {% endfor %}
  </table>
  {% else %}
  <p>{{ t('report.text.no_manual_rules') }}</p>
  {% endif %}
</section>

<section id="appendix">
  <h2>{{ t('report.section.appendix') }}</h2>
  <h3>{{ t('report.label.effective_params') }}</h3>
  <table>
    <tr><th>{{ t('report.label.rule') }}</th><th>{{ t('report.label.parameter') }}</th><th>{{ t('report.label.threshold') }}</th><th>{{ t('report.label.origin') }}</th></tr>
    {% for rule_id, params in results.config.effective_params.items() %}{% for name, p in params.items() %}
    <tr><td class="mono">{{ rule_id }}</td><td>{{ name }}</td><td>{{ fmt.value(p.value) }}</td><td>{{ t('report.text.origin_' ~ p.origin) }}</td></tr>
    {% endfor %}{% endfor %}
  </table>
  <h3>{{ t('report.label.exceptions') }}</h3>
  {% if results.exceptions %}
  <table>
    <tr><th>{{ t('report.label.rule') }}</th><th>{{ t('report.label.file') }}</th><th>{{ t('report.label.exception_reason') }}</th><th>{{ t('report.label.approved_by') }}</th><th>{{ t('report.label.valid_until') }}</th><th>{{ t('report.label.used') }}</th></tr>
    {% for use in results.exceptions %}
    <tr><td class="mono">{{ use.entry.rule }}{% if use.entry.subkey %} / {{ use.entry.subkey }}{% endif %}</td><td class="mono">{{ fmt.value(use.entry.object) }}</td><td>{{ use.entry.reason }}</td><td>{{ fmt.value(use.entry.approved_by) }}</td><td>{{ fmt.value(use.entry.valid_until.isoformat() if use.entry.valid_until else None) }}</td><td>{{ fmt.value(use.used) }}</td></tr>
    {% endfor %}
  </table>
  {% else %}
  <p>{{ t('report.text.no_exceptions') }}</p>
  {% endif %}
  <h3>{{ t('report.label.notices') }}</h3>
  {% if results.notices %}
  <ul>{% for n in results.notices %}<li>{{ t('severity.' ~ n.level.value) }}: {{ t(n.message_key, **n.params) }}</li>{% endfor %}</ul>
  {% else %}
  <p>{{ t('report.text.no_notices') }}</p>
  {% endif %}
  <h3>{{ t('report.label.configuration') }}</h3>
  <p class="mono">SHA-256 {{ results.config.canonical_sha256 }}</p>
  <pre>{{ settings_json }}</pre>
  <p class="disclaimer">{{ t('disclaimer') }}</p>
</section>

<footer>NeuroGrid {{ results.tool.version }} · {{ results.config.as_of.isoformat() }} · {{ t('disclaimer') }}</footer>
</body>
</html>
