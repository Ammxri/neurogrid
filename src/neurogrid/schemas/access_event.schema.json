{
  "additionalProperties": false,
  "description": "One entry of access.jsonl (DM-09). Every field is required (null where the value is unknown), so the\nhash input is exactly the stored object without ``hash`` (neurogrid.vault.ledger).",
  "properties": {
    "action": {
      "enum": [
        "read",
        "check",
        "convert",
        "report",
        "export",
        "consent_manage"
      ],
      "title": "Action",
      "type": "string"
    },
    "approval_ref": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approval Ref"
    },
    "format_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hash",
      "type": "string"
    },
    "objects": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Objects",
      "type": "array"
    },
    "previous_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Previous Hash",
      "type": "string"
    },
    "purpose": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Purpose"
    },
    "role": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Role"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "time": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Time",
      "type": "string"
    },
    "tool_version": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "format_version",
    "seq",
    "time",
    "role",
    "action",
    "objects",
    "purpose",
    "approval_ref",
    "tool_version",
    "previous_hash",
    "hash"
  ],
  "title": "AccessEvent",
  "type": "object"
}
