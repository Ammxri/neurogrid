    "ExceptionEntry": {
      "additionalProperties": false,
      "description": "A justified exception from neurogrid.toml (NG-F18, A-14).\n\n``object`` is a pattern over relative POSIX paths; pseudonymous recording IDs match as well.",
      "properties": {
        "approved_by": {
          "anyOf": [
            {
              "maxLength": 80,
