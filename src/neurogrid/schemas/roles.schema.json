{
  "$defs": {
    "Role": {
      "additionalProperties": false,
      "description": "One role of the register (A-93). ``actions`` is kept in the order of model.access.ACTIONS, so equal\nroles are equal objects however the file lists the actions; ``objects`` keeps the order of the file.",
      "properties": {
        "actions": {
          "items": {
            "enum": [
              "read",
              "check",
              "convert",
              "report",
              "export",
              "consent_manage"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Actions",
          "type": "array",
          "uniqueItems": true
        },
        "description": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "ethics_approval_ref": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "pattern": "\\S",
          "title": "Ethics Approval Ref"
        },
        "objects": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^(?!/)(?!.*[\\\\:])(?!(?:.*/)?\\.\\.(?:/|$))[^\\x00-\\x1f\\x7f-\\x9f]+$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Objects",
          "type": "array"
        },
        "role": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "description",
        "actions",
        "objects"
      ],
      "title": "Role",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The whole roles.yaml. ``format_version`` and ``roles`` are required in a file (parse_roles, and the\nschema); the defaults only serve NeuroGrid's own construction. Role names are unique (parse_roles).",
  "properties": {
    "format_version": {
      "const": 1,
      "default": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/Role"
      },
      "maxItems": 200,
      "title": "Roles",
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "roles"
  ],
  "title": "RoleRegister",
  "type": "object"
}
