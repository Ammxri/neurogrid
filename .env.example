# Environment variables of NeuroGrid, its tools and its workflows. Every value stays empty here: copy to .env
# (ignored by git) or set them in your shell. NeuroGrid and its tools read os.environ only; nothing reads a .env
# file by itself. Secrets never go into the repository.

# --- NeuroGrid (the command line) ----------------------------------------------------------------------------
# Language of messages: zh or en (otherwise --lang or the system language; A-07).
NEUROGRID_LANG=
# Folder of the PDF browser (Chrome Headless Shell 1243). Default: %LOCALAPPDATA%\NeuroGrid\pdf-browser
# (Windows) or ${XDG_DATA_HOME:-~/.local/share}/neurogrid/pdf-browser (Linux). Absolute local path only.
NEUROGRID_PDF_BROWSER_DIR=

# --- tests --------------------------------------------------------------------------------------------------
# 1 = PDF tests fail instead of skipping when no PDF browser is installed (CI and the final local run).
NEUROGRID_REQUIRE_PDF=

# --- tools (bundle, documentation, licences) ------------------------------------------------------------------
# Path of the uv binary used by tools/bundle.py and tools/licenses.py (uv run sets it; otherwise uv from PATH).
UV=
# Download cache of tools/bundle.py (default .local/bundle-cache).
NEUROGRID_BUNDLE_CACHE=
# owner/repo whose release workflow signs the bundles; GitHub Actions sets GITHUB_REPOSITORY instead. Not secret.
NEUROGRID_RELEASE_REPOSITORY=
# Seconds since 1970 that fix every timestamp of bundles and documentation (default: commit time of HEAD).
SOURCE_DATE_EPOCH=

# --- signing (D-10 g) --------------------------------------------------------------------------------------------
# Sigstore keyless signing needs no key and no secret: release.yml signs with GitHub's OIDC token.

# --- Gitee mirror (TECH-08; repository settings of the owner, not variables of a local shell) -------------------
# Repository variables: GITEE_MIRROR=true switches the mirror on; GITEE_REPOSITORY = owner/repo on Gitee;
# GITEE_KNOWN_HOSTS = Gitee's SSH host key line(s), checked by the owner.
GITEE_MIRROR=
GITEE_REPOSITORY=
GITEE_KNOWN_HOSTS=
# GitHub Actions secret only (environment "gitee"): private SSH key used only for the mirror. Never in a file.
GITEE_SSH_KEY=

# --- PyPI (D-07) ----------------------------------------------------------------------------------------------------
# Trusted Publishing (publish-pypi.yml, environments testpypi and pypi) needs no token. Only if the owner declines
# Trusted Publishing: a project-scoped token as GitHub Actions secret PYPI_API_TOKEN (then the workflow changes).
PYPI_API_TOKEN=
